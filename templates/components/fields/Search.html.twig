{% set name = name|default(id) %}
{% set id = id|default(name) %}
{% set base_class = "w-full rounded-lg px-3.5 py-3 outline-none focus:ring-2 focus:ring-offset-0 transition-all peer select-none" %}
{% set normal_border = "border border-gray-400 focus:ring-blue-200 focus:ring-offset-white focus:border-blue-500" %}
{% set error_border = "border border-[var(--red)] text-red-900 placeholder-red-700 focus:ring-red-300" %}
{# Room on the leading edge for the magnifier and on the trailing edge for the clear button. #}
{% set variant_class = "!ps-14 !pe-9 !text-base" %}
{% set normal_class = base_class ~ ' ' ~ normal_border ~ ' ' ~ variant_class %}
{% set final_class = error is empty ? normal_class : base_class ~ ' ' ~ error_border ~ ' ' ~ variant_class %}

{# "reset": back to the default value, dropping the server-rendered error styling. "set": adopt the dispatched value. #}
{% set on_reset %}
  $refs.{{ name }}_error?.remove();
  $el.className = '{{ normal_class }}';
  $el.value = '{{ defaultValue }}';
  $el.dispatchEvent(new Event('input'));
{% endset %}
{% set on_set %}
  $el.value = $event.detail || '{{ defaultValue }}';
  $el.dispatchEvent(new Event('input'));
{% endset %}

{# Clicking the magnifier dispatches a "search" event. The parent component's container needs to catch that. Example in templates/views/user/topic/index.html.twig #}
<div class="w-full flex flex-col component-input" x-data="{ hasValue: false }">
  {% if label is not empty %}
    <label {% if name is not empty %} for="{{ name }}" {% endif %} class="text-sm text-zinc-400 mb-1">
      {{ label }}
      {% if required %}
        <span class="text-(--red)">
          *
        </span>
      {% endif %}
    </label>
  {% endif %}

  <div class="w-full relative">
    <div class="w-10 h-10 absolute left-2 top-1 cursor-pointer rounded-full p-4 flex items-center justify-center hover:text-(--blue) active:text-(--blue)" x-bind:class="darkMode?'text-white hover:bg-gray-800 active:bg-gray-700':'hover:bg-gray-100 active:bg-gray-200'" @click="$dispatch('search', $refs.{{ name }}.value)">
      <div class="w-5 h-5 absolute">
        {{ include('icons/search.svg') }}
      </div>
    </div>

    <input x-ref="{{ name }}" type="text" @input="hasValue = $el.value.length > 0" name="{{ name }}" id="{{ id }}" {% if label is not empty %} aria-label="{{ label }}" {% endif %} {{ attributes.defaults({ class: final_class }) }} value="{{ value|default('') }}" x-on:reset="{{ on_reset }}" x-on:set="{{ on_set }}">

    {% if error is not empty %}
      <div id="{{ name }}_error" x-ref="{{ name }}_error" class="mt-1 text-xs text-(--red)">
        {{ error }}
      </div>
    {% endif %}

    <div x-show="hasValue" class="w-10 h-10 absolute right-2 top-1 cursor-pointer rounded-full p-4 flex items-center justify-center" x-bind:class="darkMode?'text-white hover:bg-gray-800 active:bg-gray-700':'hover:bg-gray-100 active:bg-gray-200'" @click="$refs.{{ name }}.value = ''; hasValue = false; $dispatch('search', '')">
      <div class="w-4 h-4 absolute">
        {{ include('icons/close.svg') }}
      </div>
    </div>
  </div>
</div>
