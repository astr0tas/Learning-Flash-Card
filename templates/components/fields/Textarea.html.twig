{% set name = name|default(id) %}
{% set id = id|default(name) %}
{% set base_class = "w-full rounded-lg px-3.5 py-3 outline-none focus:ring-2 focus:ring-offset-0 transition-all peer select-none" %}
{% set normal_border = "border border-gray-400 focus:ring-blue-200 focus:ring-offset-white focus:border-blue-500" %}
{% set error_border = "border border-[var(--red)] text-red-900 placeholder-red-700 focus:ring-red-300" %}
{% set variant_class = "!text-base" %}
{% set normal_class = base_class ~ ' ' ~ normal_border ~ ' ' ~ variant_class %}
{% set final_class = error is empty ? normal_class : base_class ~ ' ' ~ error_border ~ ' ' ~ variant_class %}

{# "reset": back to the default value, dropping the server-rendered error styling. "set": adopt the dispatched value. #}
{% set on_reset %}
  $refs.{{ name }}_error?.remove();
  $el.className = '{{ normal_class }}';
  $el.value = '{{ defaultValue }}';
  $el.dispatchEvent(new Event('input'));
{% endset %}
{% set on_set %}
  $el.value = $event.detail || '{{ defaultValue }}';
  $el.dispatchEvent(new Event('input'));
{% endset %}

<div class="w-full flex flex-col component-input">
  {% if label is not empty %}
    <label {% if name is not empty %} for="{{ name }}" {% endif %} class="text-sm text-zinc-400 mb-1">
      {{ label }}
      {% if required %}
        <span class="text-(--red)">
          *
        </span>
      {% endif %}
    </label>
  {% endif %}

  <div class="w-full relative">
    <textarea x-ref="{{ name }}" name="{{ name }}" id="{{ id }}" {% if label is not empty %} aria-label="{{ label }}" {% endif %} {{ attributes.defaults({ class: final_class }) }} x-on:reset="{{ on_reset }}" x-on:set="{{ on_set }}">
      {{ value|default('') }}
    </textarea>

    {% if error is not empty %}
      <div id="{{ name }}_error" x-ref="{{ name }}_error" class="mt-1 text-xs text-(--red)">
        {{ error }}
      </div>
    {% endif %}
  </div>
</div>
