{% props error = [], topicId = null %}

{#
  The "create a card" form. Only one instance may exist per page: it owns the
  new_card_* element ids and listens for the global "reset-new-card-inputs" event.
#}
{% set card_title = error.newCardTitle|default('') %}
{% set card_subtitle = error.newCardSubtitle|default('') %}
{% set card_description = error.newCardDescription|default('') %}
{% set card_type = error.newCardType|default('') %}
{% set card_color = error.newCardColor|default(constant('App\\Config\\Constants::FLASH_CARD_DEFAULT_COLOR')) %}
{% set card_text_color = error.newCardTextColor|default(constant('App\\Config\\Constants::FLASH_CARD_DEFAULT_TEXT_COLOR')) %}
{% set errors = error.newCardError|default({}) %}

{# contenteditable keeps pasted markup unless we force the clipboard down to plain text. #}
{% set on_paste = "document.execCommand('insertText', false, $event.clipboardData.getData('text/plain'))" %}

{# Trigger change event in the case of new card creation validation error to update the select display div with the correct selected option text #}
{% set on_init %}
  $nextTick(() => document.getElementById('card_type').dispatchEvent(new CustomEvent('set', { detail: '{{ card_type }}' })))
{% endset %}
{# "reset-new-card-inputs": blank every field, including the contenteditable ones Alpine does not own, and drop the server-rendered errors. #}
{% set on_reset_inputs %}
  document.getElementById('div_new_card_title').innerText = ''; title = '';
  document.getElementById('div_new_card_subtitle').innerText = ''; subtitle = '';
  document.getElementById('div_new_card_description').innerHTML = ''; description = '';
  document.getElementById('card_type').dispatchEvent(new Event('reset'));
  document.getElementById('card_color').dispatchEvent(new Event('reset'));
  document.getElementById('card_text_color').dispatchEvent(new Event('reset'));
  document.getElementById('new_card_title_error')?.remove();
  document.getElementById('new_card_subtitle_error')?.remove();
  document.getElementById('new_card_description_error')?.remove();
{% endset %}

<div class="flex flex-col gap-5 z-50 w-full h-full" x-data="{ title: {{ card_title|json_encode }}, subtitle: {{ card_subtitle|json_encode }}, description: {{ card_description|json_encode }}, cardColor: '{{ card_color }}', textColor: '{{ card_text_color }}' }" x-init="{{ on_init }}" @reset-new-card-inputs.window="{{ on_reset_inputs }}">
  {% if topicId %}
    <input hidden name="topic" value="{{ topicId }}" />
  {% endif %}
  <input hidden name="title" :value="title">
  <input hidden name="subtitle" :value="subtitle">
  <input hidden name="description" :value="description">
  <div class="w-full h-full flex flex-col gap-5 relative rounded-md py-10 px-3" x-bind:style="{ backgroundColor: cardColor, color: textColor }">
    <div class="flex flex-col gap-3 text-center">
      <h2 class="text-5xl" id="div_new_card_title" contenteditable @paste.prevent="{{ on_paste }}" @input="title = $el.innerText" data-placeholder="{{ 'topic.card_title'|trans }}">{{ card_title }}</h2>
      {% if errors.title is defined %}
        <div id="new_card_title_error" class="mt-1 text-xs text-(--red)">
          {{ errors.title[0] }}
        </div>
      {% endif %}
    </div>
    <div class="flex flex-col gap-3 text-center">
      <h5 class="text-xl" id="div_new_card_subtitle" contenteditable @paste.prevent="{{ on_paste }}" @input="subtitle = $el.innerText" data-placeholder="{{ 'topic.card_subtitle'|trans }}">{{ card_subtitle }}</h5>
      {% if errors.subtitle is defined %}
        <div id="new_card_subtitle_error" class="mt-1 text-xs text-(--red)">
          {{ errors.subtitle[0] }}
        </div>
      {% endif %}
    </div>
    <div class="flex flex-col gap-3 text-start">
      <div class="flex-1 whitespace-pre-line text-md overflow-auto scroll-container" id="div_new_card_description" contenteditable @paste.prevent="{{ on_paste }}" @input="description = $el.innerHTML" data-placeholder="{{ 'topic.card_description'|trans }}">{{ card_description|raw }}</div>
      {% if errors.description is defined %}
        <div id="new_card_description_error" class="mt-1 text-xs text-(--red)">
          {{ errors.description[0] }}
        </div>
      {% endif %}
    </div>
  </div>

  <div class="flex flex-col gap-5 w-full text-start p-5 rounded-md" :class="darkMode ? 'bg-(--dark-theme-bg-color) text-(--white)' : 'bg-(--white) text-(--black)'">
    <div>
      <twig:Select name="card_type" id="card_type" label="{{ 'topic.card_type'|trans }}" aria-label="{{ 'topic.card_type'|trans }}" required error="{{ errors.card_type is defined ? errors.card_type[0] : '' }}" defaultValue="">
        <twig:block name="options">
          {% for type in constant('App\\Config\\Constants::FLASH_CARD_TYPES') %}
            <option value="{{ type }}">
              {{ ('topic.card_type_'~(type|lower))|trans }}
            </option>
          {% endfor %}
        </twig:block>
      </twig:Select>
    </div>
    <div>
      <twig:Input type="color" name="card_color" id="card_color" label="{{ 'topic.card_color'|trans }}" aria-label="{{ 'topic.card_color'|trans }}" x-model="cardColor" defaultValue="{{ constant('App\\Config\\Constants::FLASH_CARD_DEFAULT_COLOR') }}" error="{{ errors.card_color is defined ? errors.card_color[0] : '' }}" />
    </div>
    <div>
      <twig:Input type="color" name="card_text_color" id="card_text_color" label="{{ 'topic.card_text_color'|trans }}" aria-label="{{ 'topic.card_text_color'|trans }}" x-model="textColor" defaultValue="{{ constant('App\\Config\\Constants::FLASH_CARD_DEFAULT_TEXT_COLOR') }}" error="{{ errors.card_text_color is defined ? errors.card_text_color[0] : '' }}" />
    </div>
    <div class="pb-3 pt-2 flex flex-row-reverse gap-3">
      <div class="inline-flex">
        <twig:Button type="button" class="text-sm" variant="primary" title="{{ 'action.add'|trans }}" @click="$dispatch('submit-form')">
          {{ 'action.add'|trans }}
        </twig:Button>
      </div>
      <div class="inline-flex">
        <twig:Button type="button" class="text-sm" variant="outline" title="{{ 'action.cancel'|trans }}" @click="$dispatch('close-create-new-card-modal')">
          {{ 'action.cancel'|trans }}
        </twig:Button>
      </div>
    </div>
  </div>
</div>
