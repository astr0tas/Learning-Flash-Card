{% props
  cardId,
  cardTitle,
  cardSubtitle = null,
  cardDescription = null,
  cardColor = constant('App\\Config\\Constants::FLASH_CARD_DEFAULT_COLOR'),
  cardTextColor = constant('App\\Config\\Constants::FLASH_CARD_DEFAULT_TEXT_COLOR'),
  model = null %}

{#
  Card preview for the topic grid. Unlike the other card components this one is
  rendered once per card; `model` is the Alpine array the selection checkbox binds to.
#}
<div class="w-full h-full flex flex-col gap-3 relative rounded-md cursor-pointer p-5" style="background-color: {{ cardColor }}; color: {{ cardTextColor }};">
  <h2 class="text-3xl text-center">
    {{ cardTitle }}
  </h2>
  <h5 class="text-center text-md">
    {{ cardSubtitle }}
  </h5>
  <div class="flex-1 text-start whitespace-pre-line text-xs overflow-hidden text-ellipsis break-words line-clamp-11">
    {{ cardDescription|raw }}
  </div>
  <div class="absolute right-2 top-2">
    <twig:ClickInput type="checkbox" class="cursor-default!" name="card_{{ cardId }}_checkbox" @click.stop x-model="{{ model }}" value="{{ cardId }}" x-bind:style="{borderColor: getContrastColor('{{ cardColor }}')}"></twig:ClickInput>
  </div>
</div>
