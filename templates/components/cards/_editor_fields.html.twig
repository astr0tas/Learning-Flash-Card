{#
  Partial shared by AddCard and EditCard, NOT a component of its own: do not render it
  with <twig:cards:_editor_fields> or include it from anywhere else.
  It reads `field_prefix` ("" / "edit_"), `errors` (the matching error bag),
  `submit_label` and `cancel_event` from the including template's context, and binds to
  the `cardColor` / `textColor` Alpine state declared there.
#}
<div class="flex flex-col gap-5 w-full text-start p-5 rounded-md" :class="darkMode ? 'bg-(--dark-theme-bg-color) text-(--white)' : 'bg-(--white) text-(--black)'">
  <div>
    <twig:Select name="card_type" id="{{ field_prefix }}card_type" label="{{ 'topic.card_type'|trans }}" aria-label="{{ 'topic.card_type'|trans }}" required error="{{ errors.card_type is defined ? errors.card_type[0] : '' }}" defaultValue="">
      <twig:block name="options">
        {% for type in constant('App\\Config\\Constants::FLASH_CARD_TYPES') %}
          <option value="{{ type }}">
            {{ ('topic.card_type_'~(type|lower))|trans }}
          </option>
        {% endfor %}
      </twig:block>
    </twig:Select>
  </div>
  <div>
    <twig:Input type="color" name="card_color" id="{{ field_prefix }}card_color" label="{{ 'topic.card_color'|trans }}" aria-label="{{ 'topic.card_color'|trans }}" x-model="cardColor" defaultValue="{{ constant('App\\Config\\Constants::FLASH_CARD_DEFAULT_COLOR') }}" error="{{ errors.card_color is defined ? errors.card_color[0] : '' }}" />
  </div>
  <div>
    <twig:Input type="color" name="card_text_color" id="{{ field_prefix }}card_text_color" label="{{ 'topic.card_text_color'|trans }}" aria-label="{{ 'topic.card_text_color'|trans }}" x-model="textColor" defaultValue="{{ constant('App\\Config\\Constants::FLASH_CARD_DEFAULT_TEXT_COLOR') }}" error="{{ errors.card_text_color is defined ? errors.card_text_color[0] : '' }}" />
  </div>
  <div class="pb-3 pt-2 flex flex-row-reverse gap-3">
    <div class="inline-flex">
      <twig:Button type="button" class="text-sm" variant="primary" title="{{ submit_label|trans }}" @click="$dispatch('submit-form')">
        {{ submit_label|trans }}
      </twig:Button>
    </div>
    <div class="inline-flex">
      <twig:Button type="button" class="text-sm" variant="outline" title="{{ 'action.cancel'|trans }}" @click="$dispatch('{{ cancel_event }}')">
        {{ 'action.cancel'|trans }}
      </twig:Button>
    </div>
  </div>
</div>
