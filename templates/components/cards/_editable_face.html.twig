{#
  Partial shared by AddCard and EditCard, NOT a component of its own: do not render it
  with <twig:cards:_editable_face> or include it from anywhere else.
  It reads `id_prefix` ("new_card" / "edit_card"), `card_title`, `card_subtitle`,
  `card_description` and `errors` (the matching error bag) from the including template's
  context, and drives the `title` / `subtitle` / `description` / `cardColor` / `textColor`
  Alpine state declared there.
#}
{# contenteditable keeps pasted markup unless we force the clipboard down to plain text. #}
{% set on_paste = "document.execCommand('insertText', false, $event.clipboardData.getData('text/plain'))" %}

<div class="w-full h-full flex flex-col gap-5 relative rounded-md py-10 px-3" x-bind:style="{ backgroundColor: cardColor, color: textColor }">
  <div class="flex flex-col gap-3 text-center">
    <h2 class="text-5xl" id="div_{{ id_prefix }}_title" contenteditable @paste.prevent="{{ on_paste }}" @input="title = $el.innerText" data-placeholder="{{ 'topic.card_title'|trans }}">{{ card_title }}</h2>
    {% if errors.title is defined %}
      <div id="{{ id_prefix }}_title_error" class="mt-1 text-xs text-(--red)">
        {{ errors.title[0] }}
      </div>
    {% endif %}
  </div>
  <div class="flex flex-col gap-3 text-center">
    <h5 class="text-xl" id="div_{{ id_prefix }}_subtitle" contenteditable @paste.prevent="{{ on_paste }}" @input="subtitle = $el.innerText" data-placeholder="{{ 'topic.card_subtitle'|trans }}">{{ card_subtitle }}</h5>
    {% if errors.subtitle is defined %}
      <div id="{{ id_prefix }}_subtitle_error" class="mt-1 text-xs text-(--red)">
        {{ errors.subtitle[0] }}
      </div>
    {% endif %}
  </div>
  <div class="flex flex-col gap-3 text-start">
    <div class="flex-1 whitespace-pre-line text-md overflow-auto scroll-container" id="div_{{ id_prefix }}_description" contenteditable @paste.prevent="{{ on_paste }}" @input="description = $el.innerHTML" data-placeholder="{{ 'topic.card_description'|trans }}">{{ card_description|raw }}</div>
    {% if errors.description is defined %}
      <div id="{{ id_prefix }}_description_error" class="mt-1 text-xs text-(--red)">
        {{ errors.description[0] }}
      </div>
    {% endif %}
  </div>
</div>
