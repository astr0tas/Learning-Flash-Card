{% extends 'layouts/user.html.twig' %}

{% block title %}
  {{ 'topic.title'|trans }}
{% endblock %}

{% set topic_array = [] %}
{% set card_array = [] %}

{% for topic in topicList %}
  {% set topicTemplate %}
  <twig:Topic topicId="{{ topic.id }}" topicName="{{ topic.name }}" model="selectedTopics" href="{{ constant('App\\Config\\Routes::TOPIC_DETAIL_ROUTE_URL')|replace({'{id}': topic.id}) }}" />
  {% endset %}

  {% set topic_array = topic_array|merge([{
    'id': topic.id,
    'name': topic.name,
    'html': topicTemplate
  }]) %}
{% endfor %}

{% for card in cardList %}
  {% set cardTemplate %}
  <twig:cards:ListCard cardId="{{ card.id }}" cardTitle="{{ card.title }}" cardSubtitle="{{ card.subtitle }}" cardDescription="{{ card.description }}" cardColor="{{ card.cardColor }}" cardTextColor="{{ card.cardTextColor }}" model="selectedCards" />
  {% endset %}

  {% set card_array = card_array|merge([{
    'title': card.title,
    'id': card.id,
    'subtitle': card.subtitle,
    'description': card.description,
    'color': card.cardColor,
    'textColor': card.cardTextColor,
    'type': card.cardType,
    'html': cardTemplate
  }]) %}
{% endfor %}

{% set new_topic_name = error.newTopicName | default('') %}
{% set objectMovingBreadcrumb = [] %}

{% for item in breadcrumb %}
  {% set objectMovingBreadcrumb = objectMovingBreadcrumb|merge([{
    'icon': item.icon|default(null),
    'label': item.label,
    'action': "document.getElementById('moveObjectModal').dispatchEvent(new CustomEvent('set-new-parent-topic', { detail: " ~ item.id|default('null') ~ " }));",
    'id': item.id
  }]) %}
{% endfor %}

{% block javascripts %}
  {{ parent() }}
  <script>
    const objectMovingBreadcrumb = {{ objectMovingBreadcrumb|json_encode|raw }};
    const fetchTopicContentUrl = "{{ constant('App\\Config\\Routes::API_USER_TOPIC_ROUTE_URL') }}";
    const apiRequestError = "{{ 'general_error.system_error'|trans }}";
    const topicList = {{ topic_array|json_encode|raw }};
    const cardList = {{ card_array|json_encode|raw }};
  </script>
  <script src="{{ asset('scripts/templates/views/user/topic/index.js') }}"></script>
{% endblock %}

{% block user_body %}
  <div class="flex flex-col w-full h-full gap-5" x-data="topic" @reset-new-topic-input.window="document.getElementById('new_topic_name').dispatchEvent(new Event('reset'))" @edit-card.window="openEditCardModal($event.detail)">
    {# Header panel #}
    <div class="flex items-center justify-between gap-2">
      {# Search bar #}
      <div class="w-full max-w-175" @search="filterTopicAndCard(document.getElementById('search').value)">
        <twig:Input type="search" name="search" placeholder="{{ 'topic.search_placeholder'|trans }}" size="9xl" @keyup.enter="filterTopicAndCard(document.getElementById('search').value)" />
      </div>
      {# Control buttons #}
      <div class="flex items-center gap-2">
        <twig:Dropdown>
          <twig:block name="dropdown_toggler">
            <twig:Button variant="primary" class="flex items-center" title="{{ 'action.create'|trans }}">
              <div class="w-5 h-5">
                {{ include('icons/plus.svg') }}
              </div>
              <div class="ms-2">
                {{ 'action.create'|trans }}
              </div>
            </twig:Button>
          </twig:block>
          <twig:block name="dropdown_content">
            <div class="py-1">
              <button class="block px-4 py-2 cursor-pointer w-full text-start" @click="document.getElementById('addNewTopicModal').setAttribute('open',true)">
                {{ 'topic.create_options.new_topic'|trans }}
              </button>
              <button class="block px-4 py-2 cursor-pointer w-full text-start" @click="document.getElementById('addNewCardModal').setAttribute('open',true)">
                {{ 'topic.create_options.new_card'|trans }}
              </button>
            </div>
          </twig:block>
        </twig:Dropdown>
        <twig:Dropdown>
          <twig:block name="dropdown_toggler">
            <twig:Button variant="outline" class="flex items-center px-1!" title="{{ 'topic.other_option'|trans }}">
              <div class="w-5 h-5 flex items-center justify-center">
                <div class="w-3 h-3 opacity-70">
                  {{ include('icons/option.svg') }}
                </div>
              </div>
            </twig:Button>
          </twig:block>
          <twig:block name="dropdown_content">
            <div class="py-1">
              <button class="flex items-center px-4 py-2 gap-1 cursor-pointer w-full hover:text-[#101828]!" @click="document.getElementById('moveObjectModal').setAttribute('open',true)" x-bind:disabled="!selectedTopics.length && !selectedCards.length" x-bind:class="!selectedTopics.length && !selectedCards.length?'!hover:opacity:20 !active:opacity-25 opacity-25!':''">
                <div class="w-5 h-5 text-inherit!">
                  {{ include('icons/move_folder.svg') }}
                </div>
                <div class="ms-2 text-inherit!">
                  {{ 'action.move'|trans }}
                </div>
              </button>
              <button class="flex items-center px-4 py-2 gap-1 cursor-pointer w-full text-(--red)!" @click="document.getElementById('deleteObjectModal').setAttribute('open',true)" x-bind:disabled="!selectedTopics.length && !selectedCards.length" x-bind:class="!selectedTopics.length && !selectedCards.length?'!hover:opacity:20 !active:opacity-25 opacity-25!':''">
                <div class="w-5 h-5 text-inherit!">
                  {{ include('icons/trash.svg') }}
                </div>
                <div class="ms-2 text-inherit!">
                  {{ 'action.delete'|trans }}
                </div>
              </button>
            </div>
          </twig:block>
        </twig:Dropdown>
      </div>
    </div>
    {# Breadcrumb #}
    <twig:Breadcrumb :items="breadcrumb"></twig:Breadcrumb>
    {# Display body #}
    <template x-if="filteredTopicList.length || filteredCardList.length">
      <div class="flex flex-col flex-1 w-full gap-10">
        {# List of topics #}
        <template x-if="filteredTopicList.length">
          <div class="flex flex-col gap-5">
            <h2 class="font-medium text-xl">
              {{ 'topic.topic_list'|trans }}
            </h2>
            <div class="gap-4 grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))]">
              <template x-for="topic in filteredTopicList">
                <div class="w-full" x-html="topic.html"></div>
              </template>
            </div>
          </div>
        </template>
        <template x-if="filteredTopicList.length && filteredCardList.length">
          <hr class="border-gray-300" />
        </template>
        {# List of cards #}
        <template x-if="filteredCardList.length">
          <div class="flex flex-col gap-3">
            <h2 class="font-medium text-xl">
              {{ 'topic.card_list'|trans }}
            </h2>
            <div class="gap-4 grid grid-cols-[repeat(auto-fill,minmax(250px,1fr))]">
              <template x-for="(card,index) in filteredCardList">
                <div class="w-full h-75" x-bind:class="darkMode?'hover:shadow-gray-700 hover:shadow-2xl':'hover:shadow-xl'" x-html="card.html" @click="openCardDetailModal(card.id)"></div>
              </template>
            </div>
          </div>
        </template>
      </div>
    </template>
    <template x-if="!filteredTopicList.length && !filteredCardList.length">
      <div class="flex-1 w-full">
        <twig:NoContent></twig:NoContent>
      </div>
    </template>
  </div>
{% endblock %}

{% block modals %}
  <twig:Modal @close="$dispatch('reset-new-topic-input')" open="{{ error.newTopicError is defined }}" modalTitle="{{ 'topic.create_options.new_topic'|trans }}" actionButtonText="{{ 'action.add'|trans }}" actionButtonVariant="primary" @modal-action="submitForm($refs.newTopicFormRef)" id="addNewTopicModal">
    <twig:block name="modal_body">
      <twig:Form x-ref="newTopicFormRef" action="{{ constant('App\\Config\\Routes::CREATE_NEW_TOPIC_ROUTE_URL') }}" method="POST">
        {% if topic is defined %}
          <twig:Input hidden name="parent_topic" value="{{ topic.id }}" />
        {% endif %}
        <div class="mb-3">
          <twig:Input type="text" name="new_topic_name" label="{{ 'topic.topic_name'|trans }}" aria-label="{{ 'topic.topic_name'|trans }}" required value="{{ new_topic_name }}" error="{{ error.newTopicError is defined and error.newTopicError.new_topic_name is defined ? error.newTopicError.new_topic_name[0] : '' }}" maxlength="{{ constant('App\\Config\\Constraints::TOPIC_NAME_MAX_LENGTH') }}" />
        </div>
      </twig:Form>
    </twig:block>
  </twig:Modal>
  <twig:Modal @close="$dispatch('reset-new-card-inputs')" open="{{ error.newCardError is defined }}" @submit-form="submitForm($refs.newCardFormRef)" @close-create-new-card-modal="document.getElementById('addNewCardModal').removeAttribute('open'); setTimeout(()=>{$dispatch('close')},250)" id="addNewCardModal">
    <twig:block name="modal_content">
      <el-dialog-panel class="w-full max-w-125 h-150">
        <twig:Form x-ref="newCardFormRef" action="{{ constant('App\\Config\\Routes::CREATE_NEW_CARD_ROUTE_URL') }}" method="POST" class="flex flex-col gap-3">
          <twig:cards:AddCard :error="error" :topicId="topic is defined ? topic.id : null" />
        </twig:Form>
      </el-dialog-panel>
    </twig:block>
  </twig:Modal>
  <twig:Modal x-data="objectMove" @close="resetMoveObjectModal()" @set-new-parent-topic="newParentTopic = $event.detail" @update-select-topic.window="selectedTopics = $event.detail" @update-select-card.window="selectedCards = $event.detail" modalTitle="{{ 'action.move'|trans }}" @modal-action="document.getElementById('moveObjectModal').removeAttribute('open'); submitForm($refs.moveObjectFormRef);" id="moveObjectModal" modalContentClass="sm:max-w-7xl!">
    <twig:block name="modal_body">
      <twig:Form x-ref="moveObjectFormRef" action="{{ constant('App\\Config\\Routes::MOVE_OBJECT_ROUTE_URL') }}" method="POST" class="hidden">
        <template x-for="selectedTopic in selectedTopics">
          <input type="hidden" name="topic[]" :value="selectedTopic"></template>
          <template x-for="selectedCard in selectedCards">
            <input type="hidden" name="card[]" :value="selectedCard"></template>
            <input type="hidden" name="newParentTopic" :value="newParentTopic"></twig:Form>
            <div class="flex flex-col gap-10">
              <div class="flex flex-col gap-5">
                <twig:Breadcrumb :items="objectMovingBreadcrumb" id="objectMovingBreadcrumb"></twig:Breadcrumb>
                <div class="w-full" @search="searchFilter = document.getElementById('search2').value">
                  <twig:Input type="search" name="search2" placeholder="{{ 'topic.search_placeholder2'|trans }}" size="9xl" @keyup.enter="searchFilter = document.getElementById('search2').value" />
                </div>
              </div>
              <template x-if="filteredParentTopicContent.length && !isLoading">
                <div class="flex flex-col gap-3">
                  <div class="flex flex-col overflow-auto hide-browser-scollbar">
                    <table>
                      <thead>
                        <tr class="border-b border-gray-400 select-none">
                          <th class="text-start py-2">
                            {{ 'topic.topic'|trans }}
                          </th>
                          <th class="w-50 text-start py-2">
                            {{ 'topic.created_at'|trans }}
                          </th>
                        </tr>
                      </thead>
                      <tbody x-data="{ selectedRecord: null }" @click.window="selectedRecord = null">
                        <template x-for="(record,index) in filteredParentTopicContent" :key="index">
                          <tr x-bind:class="{ 'border-t border-gray-400': index, 'bg-(--blue) text-(--white)': selectedRecord === index }" class="cursor-pointer select-none active:opacity-80" @click.window="if($el.contains($event.target)) { selectedRecord = index }" @dblclick="newParentTopic = record.id">
                            <td class="py-2" x-text="record.name"></td>
                            <td class="py-2" x-text="dayjs(record.createdAt).format('YYYY-MM-DD HH:mm:ss')"></td>
                          </tr>
                        </template>
                      </tbody>
                    </table>
                  </div>
                  <div class="text-(--gray) text-sm">
                    *
                    {{ 'topic.move_object_note'|trans }}
                  </div>
                </div>
              </template>
              <template x-if="!filteredParentTopicContent.length && !isLoading">
                <div class="h-[75px] w-full">
                  <twig:NoContent></twig:NoContent>
                </div>
              </template>
              <twig:Loading x-show="isLoading" id="topic-content-list-loading" class="opacity-30 h-[75px]!" :displayBackdrop="false"></twig:Loading>
            </div>
          </twig:block>
          <twig:block name="action_button">
            <twig:Button type="button" class="text-sm" variant="primary" title="{{ 'action.confirm'|trans }}" @click="$dispatch('modal-action')" x-bind:disabled="originalParent === newParentTopic" x-bind:class="{ 'cursor-not-allowed!' : originalParent === newParentTopic }">
              {{ 'action.confirm'|trans }}
            </twig:Button>
          </twig:block>
        </twig:Modal>
        <twig:Modal x-data="{ selectedTopics: [], selectedCards: [] }" @update-select-topic.window="selectedTopics = $event.detail" @update-select-card.window="selectedCards = $event.detail" modalTitle="{{ 'action.delete'|trans }}" actionButtonText="{{ 'action.delete'|trans }}" actionButtonVariant="danger" @modal-action="submitForm($refs.deleteObjectFormRef)" id="deleteObjectModal">
          <twig:block name="modal_body">
            <twig:Form x-ref="deleteObjectFormRef" action="{{ constant('App\\Config\\Routes::DELETE_OBJECT_ROUTE_URL') }}" method="POST" class="hidden">
              <template x-for="selectedTopic in selectedTopics">
                <input type="hidden" name="topic[]" :value="selectedTopic"></template>
                <template x-for="selectedCard in selectedCards">
                  <input type="hidden" name="card[]" :value="selectedCard"></template>
                </twig:Form>
                <div>
                  {{ 'topic.delete_confirm'|trans }}
                </div>
              </twig:block>
            </twig:Modal>
            <twig:Modal id="cardDetailModal" @close-view-card-modal.window="$el.removeAttribute('open')">
              <twig:block name="modal_content">
                <el-dialog-panel class="w-full max-w-125 h-150">
                  <twig:cards:ViewCard/>
                </el-dialog-panel>
              </twig:block>
            </twig:Modal>
            <twig:Modal @close="$dispatch('set-edit-card-inputs')" open="{{ error.editCardError is defined }}" @submit-form="submitForm($refs.editCardFormRef)" @close-edit-card-modal="document.getElementById('editCardModal').removeAttribute('open'); setTimeout(()=>{$dispatch('close')},250)" id="editCardModal">
              <twig:block name="modal_content">
                <el-dialog-panel class="w-full max-w-125 h-150">
                  <twig:Form x-ref="editCardFormRef" action="{{ constant('App\\Config\\Routes::UPDATE_CARD_ROUTE_URL') }}" method="POST" class="flex flex-col gap-3">
                    <twig:cards:EditCard :error="error" />
                  </twig:Form>
                </el-dialog-panel>
              </twig:block>
            </twig:Modal>
          {% endblock %}
          